{
  "packageManager": "bun@1.4.0",
  "name": "@forgeax/orchestrator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ForgeaX reusable orchestration layer: R2 compose/resolve/toWire/checkTool, session/scheduler/tree, soul (digital life), kits, llm, kernel adaptors, ledger, HTTP api routers, ws, builtin kits/personas.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kernel/forgeax-core-kernel": {
      "types": "./dist/kernel/forgeax-core-kernel.d.ts",
      "import": "./dist/kernel/forgeax-core-kernel.js"
    },
    "./npc-brain/standalone": {
      "types": "./src/npc-brain/standalone.ts",
      "import": "./dist/npc-brain/standalone.js"
    },
    "./seams": {
      "types": "./src/orchestration-seams.ts",
      "import": "./dist/orchestration-seams.js"
    },
    "./extensions": {
      "types": "./src/extensions/index.ts",
      "import": "./dist/extensions/index.js"
    },
    "./session-fs": {
      "types": "./src/fs/index.ts",
      "import": "./dist/fs/index.js"
    },
    "./gateways": {
      "types": "./src/lib/gateways/index.ts",
      "import": "./dist/lib/gateways/index.js"
    },
    "./npc-brain/model-config": {
      "types": "./src/npc-brain/model-config.ts",
      "import": "./dist/npc-brain/model-config.js"
    },
    "./kernel": {
      "types": "./src/kernel/index.ts",
      "import": "./dist/kernel/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build.mjs",
    "pack:check": "bun scripts/check-pack-externals.mjs",
    "pack:tgz": "bun run build && bun run pack:check && npm pack",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "npc-brain": "bun src/npc-brain/standalone.ts",
    "eval:npc-bots": "bun scripts/run-npc-bot-eval.ts ../.. 100",
    "measure:npc-transport": "bun scripts/measure-npc-transport.ts ../.. 100",
    "measure:npc-live": "bun scripts/measure-npc-live.ts ../..",
    "test:codex-tools-e2e": "bun test/codex-tools-e2e.ts",
    "test:codex-tools-golden": "CODEX_TOOLS_E2E_REQUIRE_LIVE=1 bun test/codex-tools-e2e.ts",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs src",
    "check:business-agnostic": "bun scripts/check-business-agnostic.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.23.0",
    "@forgeax/agent-host": "workspace:*",
    "@forgeax/agent-runtime": "^0.1.3",
    "@forgeax/platform-io": "workspace:*",
    "@forgeax/toolkit": "0.1.2",
    "@forgeax/types": "^0.1.2",
    "@forgeax/extension-host": "0.3.0",
    "@google/genai": "^1.0.0",
    "chokidar": "^4.0.0",
    "hono": "^4.6.0",
    "minimatch": "^10.2.5",
    "sharp": "^0.34.5",
    "yaml": "^2.8.2",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^20.0.0",
    "dependency-cruiser": "^17.4.3",
    "typescript": "^5.6.3"
  }
}
